# World Choir — environment placeholders (do not put real secrets here)

# Vercel Blob
# BLOB_READ_WRITE_TOKEN=

# Owner auth
# OWNER_EMAIL=
# OWNER_PASSWORD_HASH=
# OWNER_SESSION_SECRET=
# OWNER_RELATIONSHIP_DATE=

# Web Push (VAPID) — required for browser notifications
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_SUBJECT=mailto:owner@worldchoir.app

# Live dispatch kill switch (defaults to on when VAPID keys exist)
# PUSH_DISPATCH_ENABLED=true

# Cron worker auth for /api/cron-notifications
# CRON_SECRET=

# Optional Expo Push (native builds)
# EXPO_ACCESS_TOKEN=
