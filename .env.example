# World Choir — environment variables (placeholders only)
# Copy to .env.local for local development. Never commit real secrets.

# Vercel Blob storage (required for production data)
BLOB_READ_WRITE_TOKEN=

# Public site URL used in Wallet QR codes and pass links
WORLD_CHOIR_PUBLIC_URL=https://world-choir-app.vercel.app

# Apple Wallet / PassKit signing
APPLE_PASS_TYPE_IDENTIFIER=pass.com.yourteam.worldchoir.passport
APPLE_TEAM_IDENTIFIER=YOUR10CHAR
APPLE_WWDR_CERTIFICATE=
APPLE_PASS_CERTIFICATE=
APPLE_PASS_PRIVATE_KEY=
APPLE_PASS_CERTIFICATE_PASSWORD=
APPLE_PASS_DOWNLOAD_SECRET=

# Optional future PassKit web service (not required for v1)
# APPLE_PASS_WEB_SERVICE_URL=
# APPLE_PASS_AUTH_TOKEN=

# Owner / admin auth
OWNER_EMAIL=
OWNER_PASSWORD_HASH=
OWNER_SESSION_SECRET=
OWNER_RELATIONSHIP_DATE=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps
CARTO_API_KEY=

# Optional Google Wallet (future)
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
