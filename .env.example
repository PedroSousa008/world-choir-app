# Vercel Blob — auto-provisioned when linked to your Vercel project
BLOB_READ_WRITE_TOKEN=

# Owner admin access (server-side only — never expose in frontend)
OWNER_EMAIL=sousa.2003pedro@gmail.com
OWNER_RELATIONSHIP_DATE=10.09.2025
OWNER_PASSWORD_HASH=
OWNER_SESSION_SECRET=

# Generate password hash locally:
# node -e "const b=require('bcryptjs'); console.log(b.hashSync('YOUR_PASSWORD', 12))"

# Stripe — Creator Foundation one-time donations (server-side only for secret/webhook)
# Add these in Vercel → Project → Settings → Environment Variables (Production)
# Then redeploy. The Donate flow unlocks automatically when both keys are present.
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe webhook endpoint (Dashboard → Developers → Webhooks):
# URL: https://world-choir-app.vercel.app/api/donations?action=webhook
# Events: payment_intent.succeeded, payment_intent.payment_failed
# Note: use the unified /api/donations endpoint (Hobby plan function limit).
