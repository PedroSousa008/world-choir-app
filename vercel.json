{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/daily-acts", "destination": "/daily-acts.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/donate", "destination": "/donate.html" },
    { "source": "/memory", "destination": "/memory.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/owner-database", "destination": "/owner-database.html" },
    { "source": "/owner", "destination": "/owner.html" },
    { "source": "/members", "destination": "/members.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    },
    "api/donations/**/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
} 