{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron-notifications",
      "schedule": "* * * * *"
    }
  ],
  "rewrites": [
    { "source": "/daily-acts", "destination": "/daily-acts.html" },
    { "source": "/world-chain", "destination": "/world-chain.html" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/donate", "destination": "/donate.html" },
    { "source": "/memory", "destination": "/memory.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/owner-database", "destination": "/owner-database.html" },
    { "source": "/owner", "destination": "/owner.html" },
    { "source": "/members", "destination": "/members.html" }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30,
      "excludeFiles": "public/video/**"
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }
      ]
    },
    {
      "source": "/video/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
